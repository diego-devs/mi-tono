{
  "name": "mi-tono",
  "version": "1.3.1",
  "description": "Mi Tono: transposición de canciones MP3 en el dispositivo (PWA)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
